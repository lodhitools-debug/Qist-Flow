# ==============================================================================
# QistFlow Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase Transaction Connection Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection for Prisma Migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Authentication, JWT & Google OAuth 2.0
# ------------------------------------------------------------------------------
# Random 64-character secret for JWT session encryption
JWT_SECRET="generate_a_random_64_character_hex_string_here"
NEXTAUTH_SECRET="generate_a_random_64_character_hex_string_here"

# Public production URL of the deployed application on Vercel or custom domain
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Google Cloud OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Optional: Specific admin email that gets auto-assigned ADMIN role when logging in with Google
ADMIN_EMAIL="your.google.account@gmail.com"

# ------------------------------------------------------------------------------
# 3. AlwaysData Persistent WhatsApp Worker & Microservice Bridge
# ------------------------------------------------------------------------------
# Set on Vercel to point to the AlwaysData Baileys worker URL:
WHATSAPP_SERVICE_URL="https://your-worker.alwaysdata.net"

# Authenticated shared secret key between Vercel and AlwaysData
WHATSAPP_SERVICE_SECRET="generate_a_strong_random_service_secret_key"

# Persistent server-side session path on AlwaysData
WHATSAPP_SESSION_PATH="./whatsapp_auth"

# Rate limiting and messaging safety controls
WHATSAPP_RATE_LIMIT_MIN_DELAY_MS=6000
WHATSAPP_RATE_LIMIT_MAX_DELAY_MS=14000
WHATSAPP_DAILY_MAX_MESSAGES=250

# ------------------------------------------------------------------------------
# 4. Automated Scheduler & Cron Triggers
# ------------------------------------------------------------------------------
CRON_SECRET="generate_a_secure_cron_trigger_secret_key"

# ------------------------------------------------------------------------------
# 5. Environment
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
